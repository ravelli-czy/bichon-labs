{
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/orders?resource=stock-alerts&action=cron-run", "schedule": "0 13 * * *" },
    { "path": "/api/orders?resource=kit-shortage-alerts&action=cron-run", "schedule": "30 18 * * *" }
  ],
  "rewrites": [
    { "source": "/api/v1/:slug/OMS/orders",           "destination": "/api/orders" },
    { "source": "/api/v1/:slug/OMS/orders/:id",        "destination": "/api/orders/:id" },
    { "source": "/api/v1/:slug/WMS/products",          "destination": "/api/products" },
    { "source": "/api/v1/:slug/WMS/products/:sku",     "destination": "/api/products/:sku" },
    { "source": "/api/v1/:slug/WMS/kits",              "destination": "/api/kits" },
    { "source": "/api/v1/:slug/WMS/kits/:sku",         "destination": "/api/kits/:sku" },
    { "source": "/api/v1/:slug/WMS/locales",           "destination": "/api/locales" },
    { "source": "/api/v1/:slug/SHM/shipments",         "destination": "/api/shipments" },
    { "source": "/api/v1/:slug/SHM/shipments/:id",     "destination": "/api/shipments/:id" },
    { "source": "/api/v1/:slug/IAM/users",             "destination": "/api/users" },
    { "source": "/api/v1/:slug/IAM/logs",              "destination": "/api/users?action=logs" },

    { "source": "/orders",                    "destination": "/" },
    { "source": "/orders/new",                "destination": "/" },
    { "source": "/orders/:id",                "destination": "/" },
    { "source": "/orders/:id/edit",           "destination": "/" },
    { "source": "/orders/:id/duplicate",      "destination": "/" },
    { "source": "/ventas",                    "destination": "/" },
    { "source": "/inventory",                 "destination": "/" },
    { "source": "/inventory/sku/new",         "destination": "/" },
    { "source": "/inventory/sku/:sku/edit",   "destination": "/" },
    { "source": "/inventory/kit/new",         "destination": "/" },
    { "source": "/inventory/kit/:sku/edit",   "destination": "/" },
    { "source": "/catalog",                   "destination": "/" },
    { "source": "/catalog/sku/new",           "destination": "/" },
    { "source": "/catalog/sku/:sku/edit",     "destination": "/" },
    { "source": "/catalog/kit/new",           "destination": "/" },
    { "source": "/catalog/kit/:sku/edit",     "destination": "/" },
    { "source": "/meson-creativo",            "destination": "/" },
    { "source": "/reportes",                  "destination": "/" },
    { "source": "/locales",                   "destination": "/" },
    { "source": "/stock-receipts",             "destination": "/" },
    { "source": "/delivery-hub",              "destination": "/" },
    { "source": "/precios",                   "destination": "/" },
    { "source": "/shipments",                 "destination": "/delivery" },
    { "source": "/shipments/:id",             "destination": "/delivery" }
  ]
}
